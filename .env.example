# 이 파일을 `.env`로 복사한 뒤 값을 채운다. `.env`는 Git에 올리지 않는다.
# pre-commit Hook이 `.env`를 셸로 불러오므로(`. ./.env`) `&` 같은 특수문자가 있는 값은 따옴표로 감싼다.
# 실제 값이나 Secret은 이 파일에 작성하지 않는다.
# 환경변수를 추가하면 이 파일에도 함께 반영한다.

# --- Database (MySQL) ---
DB_URL="jdbc:mysql://localhost:3306/your_database?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# --- AWS S3 (상품 이미지 Presigned URL) ---
# 자격 증명은 이 파일이 아니라 AWS SDK 기본 자격 증명 체인(환경변수, ~/.aws 등)에서 읽는다.
AWS_REGION=ap-northeast-2
PRODUCT_IMAGE_BUCKET=your-product-image-bucket

# --- JWT ---
# Base64로 인코딩된 Secret. 예: openssl rand -base64 32
JWT_SECRET_BASE64=
JWT_ISSUER=https://your-issuer.example

# --- CORS ---
# 허용할 Origin 목록. 예: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- 로그인 Rate Limit ---
# Base64로 인코딩된 HMAC Secret. 예: openssl rand -base64 32
LOGIN_RATE_LIMIT_HMAC_SECRET_BASE64=
