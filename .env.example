# 이 파일을 `.env`로 복사한 뒤 값을 채운다. `.env`는 Git에 올리지 않는다.
# pre-commit Hook이 `.env`를 셸로 불러오므로(`. ./.env`) `&` 같은 특수문자가 있는 값은 따옴표로 감싼다.
# 실제 값이나 Secret은 이 파일에 작성하지 않는다.
# 환경변수를 추가하면 이 파일에도 함께 반영한다.

# --- Database (MySQL) ---
DB_URL="jdbc:mysql://localhost:3306/your_database?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# --- Redis (Docker deployment) ---
# Backend and Redis must share the gift-redis_default network.
REDIS_HOST=redis
REDIS_PORT=6379
# Generate a unique value with: openssl rand -hex 32
# Use the same secret for the Redis service and backend; never commit it.
REDIS_PASSWORD=

# 그룹별 비밀번호는 기존 REDIS_PASSWORD를 기본값으로 사용한다.
# REDIS_AUTH_PASSWORD=
# REDIS_PRODUCT_PASSWORD=
# 기본 false: 기존 개발 환경의 고정 주소 연결 유지.
# Sentinel 모드에서는 해당 그룹의 host/port 대신 아래 주소와 master 이름 사용.
REDIS_AUTH_SENTINEL_ENABLED=false
REDIS_AUTH_SENTINEL_MASTER=
REDIS_AUTH_SENTINEL_NODES=
REDIS_AUTH_SENTINEL_PASSWORD=
REDIS_PRODUCT_SENTINEL_ENABLED=false
REDIS_PRODUCT_SENTINEL_MASTER=
REDIS_PRODUCT_SENTINEL_NODES=
REDIS_PRODUCT_SENTINEL_PASSWORD=
# V3 master 이름: 인증 redis-auth / 상품 redis-product.
# nodes 형식: sentinel-0.example:26379,sentinel-1.example:26379,sentinel-2.example:26379
# Sentinel 비밀번호는 데이터 Redis 비밀번호와 별도로 주입한다.

# --- Payment Server ---
PAYMENT_SERVER_PORT=8090
PAYMENT_SERVER_API_KEY=로컬에서_사용할_충분히_긴_임의의_키

# --- AWS S3 (상품 이미지 Presigned URL) ---
# 자격 증명은 이 파일이 아니라 AWS SDK 기본 자격 증명 체인(환경변수, ~/.aws 등)에서 읽는다.
AWS_REGION=ap-northeast-2
PRODUCT_IMAGE_BUCKET=your-product-image-bucket
S3_TEST_OBJECT_KEY=your-product-image-file-path

# --- JWT ---
# Base64로 인코딩된 Secret. 예: openssl rand -base64 32
JWT_SECRET_BASE64=
JWT_ISSUER=https://your-issuer.example

# --- CORS ---
# 허용할 Origin 목록. 예: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- 로그인 Rate Limit ---
# Base64로 인코딩된 HMAC Secret. 예: openssl rand -base64 32
LOGIN_RATE_LIMIT_HMAC_SECRET_BASE64=

# ElasticSearch -> PRODUCT_SEARCH_ENABLED 는 ES가 운영환경에 적용된다면 true로 설정
ELASTICSEARCH_URIS=http://127.0.0.1:9201
PRODUCT_SEARCH_INDEX=gift-products-local-v1
PRODUCT_SEARCH_ENABLED=false
# 상품 변경 Outbox 기록만 활성화.
# 운영 동기화 검증 전까지 기록과 작업자 모두 기본 OFF 유지.
PRODUCT_SEARCH_OUTBOX_ENABLED=false

# 기록된 작업을 ES에 반영하는 작업자
PRODUCT_SEARCH_SYNC_ENABLED=false
PRODUCT_SEARCH_SYNC_POLL_INTERVAL_MS=5000
PRODUCT_SEARCH_SYNC_BATCH_SIZE=100
PRODUCT_SEARCH_SYNC_LEASE_SECONDS=60
PRODUCT_SEARCH_SYNC_MAX_FAILURES=10
PRODUCT_SEARCH_SYNC_RETRY_BASE_SECONDS=2
PRODUCT_SEARCH_SYNC_RETRY_MAX_SECONDS=300

# --- AI 서버 통신 ---
# PR4 운영 복구·제어 완료 전에는 운영 환경에서 활성화하지 않는다.
AI_PROFILE_RESULT_CONSUMER_ENABLED=false
# MQ 자동 발행은 AI_PROFILE_AMQP_ENABLED와 함께 true로 설정한다.
AI_PROFILE_SCHEDULING_ENABLED=true

AI_PROFILE_BASE_URL=http://localhost:8000
PROFILING_SERVICE_TOKEN=local-profiling-token
AI_PROFILE_CONNECT_TIMEOUT=3s
AI_PROFILE_READ_TIMEOUT=10s
AI_PROFILE_BATCH_SIZE=100
# 신규·재시도 발행 합계는 인스턴스당 한 틱에 최대 100건
AI_PROFILE_DISPATCH_INTERVAL=1m
# 프로파일링 종료 작업 정리: 매일 03:30 Asia/Seoul
AI_PROFILE_CLEANUP_ENABLED=true

AI_CHAT_BASE_URL=https://wjo-ai-chat-demo.hf.space/v1/chat/conversations
AI_CHAT_SERVICE_TOKEN=<AI 담당자가 전달한 서비스 토큰>
AI_CHAT_CONNECT_TIMEOUT=<확정한 연결 timeout>
AI_CHAT_READ_TIMEOUT=<확정한 JSON 응답 timeout>
AI_CHAT_SSE_IDLE_TIMEOUT=60s
AI_CHAT_SSE_TOTAL_TIMEOUT=240s
AI_CHAT_SSE_MAX_CONNECTIONS=<배포 환경별 동시 연결 상한>
CHAT_CONVERSATION_TOKEN_SECRET_BASE64=<별도로 생성한 비밀키>
CHAT_CONVERSATION_TOKEN_ISSUER=<대화 토큰 전용 issuer>

# Shared RabbitMQ — Compose and BE
AI_PROFILE_AMQP_ENABLED=false

# 기존 profiling-rabbitmq 데이터 볼륨을 재사용할 때는 profiling-rabbitmq로 지정
RABBITMQ_HOSTNAME=gift-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Absolute path to a private access definitions JSON, outside the repository.
RABBITMQ_ACCESS_DEFINITIONS_FILE=

# Local: 1 / Three-node environment: 3
AI_PROFILE_QUORUM_INITIAL_GROUP_SIZE=1

# --- Payment Server ---
PAYMENT_SERVER_PORT=8090
PAYMENT_SERVER_BASE_URL=http://localhost:8090
PAYMENT_SERVER_API_KEY=로컬에서_사용할_충분히_긴_임의의_키
PAYMENT_CONNECT_TIMEOUT=1s
PAYMENT_COMMAND_TIMEOUT=3s
PAYMENT_QUERY_TIMEOUT=2s
PAYMENT_RECONCILIATION_INTERVAL=1m
PAYMENT_RECONCILIATION_BATCH_SIZE=100
PAYMENT_RECONCILIATION_STALE_AGE=1m
PAYMENT_RECONCILIATION_TIMEOUT=10m

# --- 스케줄링 ---
SCHEDULING_ENABLED=true

# --- 버그 제보 (Discord + Google Sheets) ---
# 외부 채널 설정은 해당 Consumer 활성화 시 필요하다. JSON 접수 API는 외부 전달 완료를 기다리지 않는다.
DISCORD_WEBHOOK_URL=

# Google Cloud에서 발급한 서비스 계정 JSON 파일 전체를 Base64로 인코딩한 값
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Google Sheet URL의 /d/와 /edit 사이 값
GOOGLE_SHEET_ID=
# 버그 제보를 추가할 시트 탭 이름
GOOGLE_SHEET_TAB=버그 제보

# --- Sentry ---

# 빌드 시 소스 컨텍스트 업로드에만 사용한다.
# 로컬 실행 및 런타임 컨테이너에는 없어도 된다.
SENTRY_AUTH_TOKEN=
# 애플리케이션 오류 전송 주소
SENTRY_DSN=
# local, development, staging, production 등
SENTRY_ENVIRONMENT=local
# 요청 헤더와 IP 등 개인정보 전송 여부
SENTRY_SEND_DEFAULT_PII=false
# 성능 추적 비율. 0.0이면 성능 추적 비활성화
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Monitoring (explicit monitoring profile only) ---
# Generate with: openssl rand -hex 32. Use the same value for app and configure.py.
MONITORING_PASSWORD=
MANAGEMENT_SERVER_PORT=8081
# Host JVM: loopback by default. Container JVM: 0.0.0.0, with no published management port.
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
APP_METRICS_TARGET=host.docker.internal:8081
MONITORING_NETWORK=gift-monitoring
DOCKER_SOCKET_PATH=/var/run/docker.sock
MYSQL_EXPORTER_HOST=host.docker.internal
MYSQL_EXPORTER_PORT=3306
MYSQL_EXPORTER_USER=monitoring
MYSQL_EXPORTER_PASSWORD=
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_RETENTION=7d
PROMETHEUS_RETENTION_SIZE=2GB
# Optional RabbitMQ detailed metrics, profiling metrics and Alertmanager; use Compose --profile profiling.
PROFILING_MONITORING_ENABLED=false
RABBITMQ_METRICS_PORT=15692
RABBITMQ_METRICS_TARGET=host.docker.internal:15692
LOCAL_ALERT_WEBHOOK_URL=http://host.docker.internal:19093/alerts
# Optional monitoring-only Discord webhook for payment DLQ alerts; it is not read from DISCORD_WEBHOOK_URL.
# Store the BE_ERROR webhook here, not in Git.
ALERTMANAGER_DISCORD_WEBHOOK_URL=
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=10
HIKARI_CONNECTION_TIMEOUT_MS=30000

# Common Outbox DB claim and recovery settings
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_FAILURES=10
OUTBOX_RETRY_BASE_SECONDS=2
OUTBOX_RETRY_MAX_SECONDS=300

# Enable only after domain consumers and cutover are ready.
OUTBOX_ENABLED=false
OUTBOX_SEARCH_BATCH_SIZE=10
OUTBOX_CONFIRM_TIMEOUT_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000
# Notification/report completed Outbox cleanup (independent of MQ relay enablement).
OUTBOX_CLEANUP_INTERVAL_MS=3600000
SPRING_RABBITMQ_HOST=127.0.0.1
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=gift-backend
SPRING_RABBITMQ_PASSWORD=
SPRING_RABBITMQ_VIRTUAL_HOST=gift

# Shared Management API access; required only by features that import its configuration.
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
RABBITMQ_MANAGEMENT_USERNAME=
RABBITMQ_MANAGEMENT_PASSWORD=

# Set only after the team confirms existing exchange/bindings. Required when enabled.
OUTBOX_RABBIT_EXCHANGE=
OUTBOX_SEARCH_ROUTING_KEY=

# Report topology is imported when the custom RabbitMQ image starts.
# Enable only after provisioning and when the report consumers are ready.
REPORT_MQ_ENABLED=false
REPORT_MQ_BATCH_SIZE=10
# Requires OUTBOX_ENABLED=true; producer activation is independent.
REPORT_DISCORD_CONSUMER_ENABLED=false

# Switch notification producers and the common DB worker together; the legacy drain worker stays active.
NOTIFICATION_COMMON_OUTBOX_ENABLED=false
# Requires OUTBOX_ENABLED=true and valid Google service-account/project settings.
REPORT_SHEETS_CONSUMER_ENABLED=false

# One-off operator CLI: explicit scope is required; execute remains false unless deliberately changed.
REPLAY_TARGET=
REPLAY_IDS=
REPLAY_LIMIT=
REPLAY_OPERATOR=
REPLAY_EXECUTE=false

PAYMENT_MQ_TOPOLOGY_ENABLED=false
# 결제 후속 작업 MQ 발행기와 룰렛·쿠폰 복구 컨슈머 스위치, 영수증 컨슈머 스위치 (기본값 false)
APP_PAYMENT_MQ_ENABLED=false
APP_PAYMENT_MQ_CONSUMER_RECEIPT_ENABLED=false
# 영수증 메일 큐 컨슈머 설정 (기본값 1)
APP_PAYMENT_MQ_CONSUMER_RECEIPT_CONCURRENCY=1
APP_PAYMENT_MQ_CONSUMER_RECEIPT_PREFETCH=1
# 룰렛 지급, 쿠폰 복구, 결제 승인·취소 복구 큐 컨슈머 설정 (기본값 1)
APP_PAYMENT_MQ_CONSUMER_ROULETTE_CONCURRENCY=1
APP_PAYMENT_MQ_CONSUMER_ROULETTE_PREFETCH=1
APP_PAYMENT_MQ_CONSUMER_COUPON_RESTORE_CONCURRENCY=1
APP_PAYMENT_MQ_CONSUMER_COUPON_RESTORE_PREFETCH=1
APP_PAYMENT_MQ_CONSUMER_RECOVERY_CONCURRENCY=1
APP_PAYMENT_MQ_CONSUMER_RECOVERY_PREFETCH=1
PAYMENT_RECOVERY_DISPATCH_ENABLED=false
PAYMENT_RECOVERY_DISPATCH_BATCH_SIZE=100
PAYMENT_RECOVERY_DISPATCH_LEASE_SECONDS=60
PAYMENT_RECOVERY_DISPATCH_POLL_INTERVAL_MS=5000

# 결제 Outbox 발행 설정 (기본값 배치 100건, 주기 500ms. 공용 OUTBOX_* 값과 별개)
APP_PAYMENT_MQ_OUTBOX_BATCH_SIZE=100
APP_PAYMENT_MQ_OUTBOX_POLL_INTERVAL_MS=500
