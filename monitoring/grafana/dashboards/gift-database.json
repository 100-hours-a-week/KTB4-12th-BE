{
  "uid": "gift-database",
  "title": "Gift / Database",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "gift",
    "monitoring"
  ],
  "annotations": {
    "list": [
      {
        "name": "Load tests",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 160, 0, 1)",
        "target": {
          "type": "tags",
          "tags": [
            "loadtest"
          ],
          "matchAny": false
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "App instance",
        "query": "label_values(up{job=\"spring\"}, instance)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "uri",
        "label": "API route",
        "query": "label_values(http_server_requests_seconds_count{job=\"spring\"}, uri)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "mysql_instance",
        "label": "MySQL exporter",
        "query": "label_values(mysql_up, instance)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "label": "Container",
        "query": "label_values(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\"}, name)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Hikari active / idle / pending / max",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "active {{instance}} {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "idle {{instance}} {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "pending {{instance}} {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "hikaricp_connections_max{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "max {{instance}} {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Hikari mean / max acquisition time",
      "description": "Acquisition wait is outside time spent using the connection. Zero acquisitions produce an undefined mean.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_acquire_seconds_sum{job=\"spring\",instance=~\"$instance\"}[$__rate_interval]) / rate(hikaricp_connections_acquire_seconds_count{job=\"spring\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "mean {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_acquire_seconds_max{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "time-window max {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Hikari mean / max usage time",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_usage_seconds_sum{job=\"spring\",instance=~\"$instance\"}[$__rate_interval]) / rate(hikaricp_connections_usage_seconds_count{job=\"spring\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "mean {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_usage_seconds_max{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "time-window max {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Hikari connection timeouts / second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_timeout_total{job=\"spring\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} {{pool}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "MySQL connected / running threads",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_threads_connected{job=\"mysql\",instance=~\"$mysql_instance\"}",
          "legendFormat": "connected",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "mysql_global_status_threads_running{job=\"mysql\",instance=~\"$mysql_instance\"}",
          "legendFormat": "running",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "MySQL query throughput",
      "description": "Exporter queries also contribute to these global counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mysql_global_status_queries{job=\"mysql\",instance=~\"$mysql_instance\"}[$__rate_interval])",
          "legendFormat": "queries including stored programs",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "rate(mysql_global_status_questions{job=\"mysql\",instance=~\"$mysql_instance\"}[$__rate_interval])",
          "legendFormat": "client statements",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "MySQL slow statements / second",
      "description": "Slow_queries counts statements exceeding long_query_time; query text requires slow log / Performance Schema separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mysql_global_status_slow_queries{job=\"mysql\",instance=~\"$mysql_instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} {{pool}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "InnoDB row lock waits / second",
      "description": "Global completed wait count; not a product-specific lock diagnosis.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mysql_global_status_innodb_row_lock_waits{job=\"mysql\",instance=~\"$mysql_instance\"}[$__rate_interval])",
          "legendFormat": "{{instance}} {{pool}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "InnoDB lock wait seconds / second",
      "description": "MySQL exports cumulative row-lock time in milliseconds. This is not instantaneous queue wait duration.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mysql_global_status_innodb_row_lock_time{job=\"mysql\",instance=~\"$mysql_instance\"}[$__rate_interval]) / 1000",
          "legendFormat": "{{instance}} {{pool}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "InnoDB current row lock waits",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_innodb_row_lock_current_waits{job=\"mysql\",instance=~\"$mysql_instance\"}",
          "legendFormat": "{{instance}} {{pool}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "InnoDB buffer pool data usage ratio",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_buffer_pool_pages{job=\"mysql\",instance=~\"$mysql_instance\",state=\"data\"} / ignoring(state) sum without(state) (mysql_global_status_buffer_pool_pages{job=\"mysql\",instance=~\"$mysql_instance\"})",
          "legendFormat": "{{instance}} {{pool}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "text",
      "title": "Find the blocking statement",
      "options": {
        "mode": "markdown",
        "content": "Global lock-wait counters narrow a hypothesis, but cannot identify the product row or blocking SQL. Inspect `performance_schema.data_lock_waits`, `data_locks`, `events_statements_current` and statement digests with a separate diagnostic account. Compare acquire time and connection usage time with lock waits and CPU."
      },
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 9
      }
    }
  ]
}
