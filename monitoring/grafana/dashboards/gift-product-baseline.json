    {
      "type": "timeseries",
      "title": "DB 연결 획득 시간 — 평균 / 시간창 최대",
      "description": "Acquisition wait is outside time spent using the connection. Zero acquisitions produce an undefined mean.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hikaricp_connections_acquire_seconds_sum{job=\"spring\",instance=~\"$instance\"}[$__rate_interval]) / rate(hikaricp_connections_acquire_seconds_count{job=\"spring\",instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "mean {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_acquire_seconds_max{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "time-window max {{pool}}",
          "datasource": {
