{
  "uid": "gift-product-baseline",
  "title": "상품 상세 Baseline",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "gift",
    "product-detail",
    "baseline",
    "loadtest"
  ],
  "annotations": {
    "list": [
      {
        "name": "Load tests",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 160, 0, 1)",
        "target": {
          "type": "tags",
          "tags": [
            "loadtest"
          ],
          "matchAny": false
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "App instance",
        "query": "label_values(up{job=\"spring\"}, instance)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "current": {
          "text": "host.docker.internal:8081",
          "value": "host.docker.internal:8081"
        }
      },
      {
        "name": "uri",
        "label": "API 경로",
        "type": "constant",
        "query": "/products/{productId}",
        "hide": 2,
        "current": {
          "text": "/products/{productId}",
          "value": "/products/{productId}"
        }
      },
      {
        "name": "mysql_instance",
        "label": "MySQL exporter",
        "query": "label_values(mysql_up, instance)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "current": {
          "text": "mysqld-exporter:9104",
          "value": "mysqld-exporter:9104"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "실험 기록·읽는 방법",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**GET /products/{productId} 전용** · 인스턴스와 실험 시간 범위를 맞춰 비교하세요. 조건: 집중/분산 · 사용자 1/10/100 · 신규 집계/재조회.\n\nJVM·Hikari·MySQL은 전체 활동(배치 포함)입니다. 순간 지연·성공 처리량·네트워크 실패는 **k6 원자료**로 확인하세요. 15초 수집의 한계가 있으며 **No data ≠ 0**입니다."
      }
    },
    {
      "type": "timeseries",
      "title": "수집 상태 — Spring / MySQL / DB",
      "description": "1=healthy, 0=failed. Exporter HTTP UP does not imply DB collection success.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "Spring {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "mysql_up",
          "legendFormat": "DB connection {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "mysql_exporter_collector_success",
          "legendFormat": "collector {{collector}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "up{job=\"mysql\",instance=~\"$mysql_instance\"}",
          "legendFormat": "MySQL exporter {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "상품 상세 GET 요청량 (RPS)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval]))",
          "legendFormat": "RPS",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "상품 상세 GET 서버 응답시간 평균 / p50 / p95 / p99",
      "description": "완료된 상품 상세 GET 요청의 서버 처리 시간입니다(실패 포함). 평균은 시간 합계/요청 수이며 요청이 없는 구간은 정의되지 않습니다. k6의 클라이언트 응답시간 및 실행 전체 요약과 구분하세요.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"spring\",instance=~\"$instance\",method=\"GET\",uri=\"$uri\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",method=\"GET\",uri=\"$uri\"}[$__rate_interval]))",
          "legendFormat": "평균",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "상품 상세 GET HTTP 4xx / 5xx 비율",
      "description": "Separate client failures and server failures; a zero-request interval has no defined error rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\",status=~\"4..\"}[$__rate_interval])) or (sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval])) * 0)) / sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval]))",
          "legendFormat": "4xx / requests",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\",status=~\"5..\"}[$__rate_interval])) or (sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval])) * 0)) / sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval]))",
          "legendFormat": "5xx / requests",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "선택 기간 상품 상세 GET 요청 수",
