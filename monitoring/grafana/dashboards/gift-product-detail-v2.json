{
  "uid": "gift-product-detail-v2",
  "title": "Gift / 상품 상세 A·B 캐시 전후 비교",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "gift",
    "product-detail-v2",
    "baseline-cache"
  ],
  "annotations": {
    "list": [
      {
        "name": "Load tests",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 160, 0, 1)",
        "target": {
          "type": "tags",
          "tags": [
            "loadtest"
          ],
          "matchAny": false
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "App instance",
        "query": "label_values(up{job=\"spring\"}, instance)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "uri",
        "label": "API route",
        "query": "/products/{productId}",
        "type": "constant",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "/products/{productId}",
          "value": "/products/{productId}"
        },
        "hide": 2
      },
      {
        "name": "mysql_instance",
        "label": "MySQL exporter",
        "query": "label_values(mysql_up, instance)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "label": "Container",
        "query": "label_values(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\"}, name)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "상품 상세 실제 서버 처리 RPS",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=\"/products/{productId}\",method=\"GET\"}[$__rate_interval]))",
          "legendFormat": "RPS",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "상품 상세 서버 응답시간 P50 / P95 / P99",
      "description": "서버 HTTP histogram 추정치. k6 성공 요청 응답시간(detail_success_duration_ms)과 측정 위치 및 모집단이 다릅니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=\"/products/{productId}\",method=\"GET\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=\"/products/{productId}\",method=\"GET\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=\"/products/{productId}\",method=\"GET\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "API 4xx / 5xx rate",
      "description": "Separate client failures and server failures; a zero-request interval has no defined error rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=\"/products/{productId}\",method=\"GET\",status=~\"4..\"}[$__rate_interval])) or (sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=\"/products/{productId}\",method=\"GET\"}[$__rate_interval])) * 0)) / sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=\"/products/{productId}\",method=\"GET\"}[$__rate_interval]))",
          "legendFormat": "4xx / requests",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=\"/products/{productId}\",method=\"GET\",status=~\"5..\"}[$__rate_interval])) or (sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=\"/products/{productId}\",method=\"GET\"}[$__rate_interval])) * 0)) / sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=\"/products/{productId}\",method=\"GET\"}[$__rate_interval]))",
          "legendFormat": "5xx / requests",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "JVM process / system CPU",
      "description": "System CPU is the OS/cgroup view seen by the JVM, not a macOS host measurement.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "process {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "system_cpu_usage{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "JVM-visible system {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "JVM heap used / max",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (jvm_memory_used_bytes{job=\"spring\",instance=~\"$instance\",area=\"heap\"})",
          "legendFormat": "used {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by(instance) (jvm_memory_max_bytes{job=\"spring\",instance=~\"$instance\",area=\"heap\"} > 0)",
          "legendFormat": "max {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "GC pause time / second",
      "description": "Seconds spent in pauses per wall-clock second; compare peaks with API latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (rate(jvm_gc_pause_seconds_sum{job=\"spring\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{pool}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
