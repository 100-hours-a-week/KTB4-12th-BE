    {
      "type": "timeseries",
      "title": "Hikari active / idle / pending / max",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "active {{instance}} {{pool}}",
          "datasource": {
            "type": "prometheus",
