{
  "uid": "gift-overview",
  "title": "Gift / Service Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "gift",
    "monitoring"
  ],
  "annotations": {
    "list": [
      {
        "name": "Load tests",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 160, 0, 1)",
        "target": {
          "type": "tags",
          "tags": [
            "loadtest"
          ],
          "matchAny": false
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "App instance",
        "query": "label_values(up{job=\"spring\"}, instance)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "uri",
        "label": "API route",
        "query": "label_values(http_server_requests_seconds_count{job=\"spring\"}, uri)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "mysql_instance",
        "label": "MySQL exporter",
        "query": "label_values(mysql_up, instance)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "label": "Container",
        "query": "label_values(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\"}, name)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gift-prometheus"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "API RPS",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval]))",
          "legendFormat": "RPS",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "API P50 / P95 / P99",
      "description": "Server processing latency. Includes completed failures; compare status and client-side latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "API 4xx / 5xx rate",
      "description": "Separate client failures and server failures; a zero-request interval has no defined error rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\",status=~\"4..\"}[$__rate_interval])) or (sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval])) * 0)) / sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval]))",
          "legendFormat": "4xx / requests",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\",status=~\"5..\"}[$__rate_interval])) or (sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval])) * 0)) / sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval]))",
          "legendFormat": "5xx / requests",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP 4xx / 5xx count in selected range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\",status=~\"4..\"}[$__range])) or sum(increase(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__range])) * 0",
          "legendFormat": "4xx",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\",status=~\"5..\"}[$__range])) or sum(increase(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__range])) * 0",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP request count in selected range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__range]))",
          "legendFormat": "{{instance}} {{pool}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "API mean latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval]))",
          "legendFormat": "mean",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "JVM process / system CPU",
      "description": "System CPU is the OS/cgroup view seen by the JVM, not a macOS host measurement.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "process {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "system_cpu_usage{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "JVM-visible system {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "JVM heap used / max",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (jvm_memory_used_bytes{job=\"spring\",instance=~\"$instance\",area=\"heap\"})",
          "legendFormat": "used {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by(instance) (jvm_memory_max_bytes{job=\"spring\",instance=~\"$instance\",area=\"heap\"} > 0)",
          "legendFormat": "max {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Container CPU (cores)",
      "description": "1.0 means one CPU core; host and process CPU percentages use different denominators.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name=~\"$container\",name!=\"\",id!=\"/\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{pool}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Container working set / usage / limit",
      "description": "Large host-sized limits can mean no explicit container limit. JVM heap is only part of container memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{job=\"cadvisor\",name=~\"$container\",name!=\"\",id!=\"/\"}",
          "legendFormat": "working set {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "container_memory_usage_bytes{job=\"cadvisor\",name=~\"$container\",name!=\"\",id!=\"/\"}",
          "legendFormat": "usage incl cache {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "container_spec_memory_limit_bytes{job=\"cadvisor\",name=~\"$container\",name!=\"\",id!=\"/\"}",
          "legendFormat": "limit {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Scrape and DB collection health",
      "description": "1=healthy, 0=failed. Exporter HTTP UP does not imply DB collection success.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"spring|mysql|cadvisor|prometheus\"}",
          "legendFormat": "scrape {{job}} {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "mysql_up",
          "legendFormat": "DB connection {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "mysql_exporter_collector_success",
          "legendFormat": "collector {{collector}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "RPS by API route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(uri,method) (rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",uri=~\"$uri\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{pool}} {{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 9
      }
    }
  ]
}
