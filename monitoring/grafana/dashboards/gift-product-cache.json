    {
      "type": "timeseries",
      "title": "상품 상세 GET 서버 응답시간 평균 / p50 / p95 / p99",
      "description": "완료된 상품 상세 GET 요청의 서버 처리 시간입니다(실패 포함). 평균은 시간 합계/요청 수이며 요청이 없는 구간은 정의되지 않습니다. k6의 클라이언트 응답시간 및 실행 전체 요약과 구분하세요.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",instance=~\"$instance\",uri!~\"/actuator.*\",method=\"GET\",uri=\"$uri\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"spring\",instance=~\"$instance\",method=\"GET\",uri=\"$uri\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"spring\",instance=~\"$instance\",method=\"GET\",uri=\"$uri\"}[$__rate_interval]))",
          "legendFormat": "평균",
          "datasource": {
            "type": "prometheus",
