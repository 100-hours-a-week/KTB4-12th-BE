        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "수집 상태 — Spring / MySQL / DB",
      "description": "1=healthy, 0=failed. Exporter HTTP UP does not imply DB collection success.",
      "datasource": {
        "type": "prometheus",
        "uid": "gift-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"spring\",instance=~\"$instance\"}",
          "legendFormat": "Spring {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "mysql_up",
          "legendFormat": "DB connection {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "mysql_exporter_collector_success",
          "legendFormat": "collector {{collector}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "up{job=\"mysql\",instance=~\"$mysql_instance\"}",
          "legendFormat": "MySQL exporter {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gift-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 102,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 7
      }
    },
