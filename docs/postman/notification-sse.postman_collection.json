{
  "info": {
    "name": "Notification SSE user-channel Redis relay",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "알림 스트림 연결",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/notifications/events"
      }
    }
  ]
}
