            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mainBaseUrl}}/gifts/sent/{{giftId}}"
          },
          "response": []
        },
        {
          "name": "결제 취소",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('cancellationIdempotencyKey', pm.variables.replaceIn('CANCEL-{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.orderId).to.eql(pm.environment.get('orderId'));",
                  "pm.expect(data.paymentStatus).to.eql('CANCELED');",
                  "pm.expect(data.giftStatus).to.eql('CANCELED');",
                  "pm.expect(data.canceledAt).to.be.a('string').and.not.empty;"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{cancellationIdempotencyKey}}" }
            ],
            "url": "{{mainBaseUrl}}/payments/{{orderId}}/cancellations"
          },
          "response": []
        },
        {
          "name": "동일 취소 요청 재전송",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.orderId).to.eql(pm.environment.get('orderId'));",
                  "pm.expect(data.paymentStatus).to.eql('CANCELED');",
