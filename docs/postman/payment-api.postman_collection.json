    {
      "name": "02. 결제 후 선물 수락",
      "description": "새 결제를 생성하고 발신자·수신자 관점의 목록 및 상세 응답을 확인한 뒤 수신자가 선물을 수락한다.",
      "item": [
        {
          "name": "선물 사전 검증",
          "auth": {
            "type": "bearer",
            "bearer": [
              { "key": "token", "value": "{{senderAccessToken}}", "type": "string" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('expectedUnitPrice', String(data.product.unitPrice));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"recipientUserId\": {{recipientUserId}},\n  \"quantity\": {{quantity}}\n}"
            },
            "url": "{{mainBaseUrl}}/gifts/preflight"
          },
          "response": []
        },
        {
          "name": "수락용 결제 승인",
          "auth": {
            "type": "bearer",
            "bearer": [
              { "key": "token", "value": "{{senderAccessToken}}", "type": "string" }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('acceptPaymentIdempotencyKey', pm.variables.replaceIn('PAYMENT-ACCEPT-{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.paymentStatus).to.eql('COMPLETED');",
                  "pm.expect(data.giftStatus).to.eql('WAITING_FOR_ACCEPTANCE');",
                  "pm.environment.set('acceptOrderId', data.orderId);",
                  "pm.environment.set('acceptGiftId', String(data.giftId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{acceptPaymentIdempotencyKey}}" },
              { "key": "X-Payment-Scenario", "value": "APPROVE" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"recipientUserId\": {{recipientUserId}},\n  \"quantity\": {{quantity}},\n  \"expectedUnitPrice\": {{expectedUnitPrice}}\n}"
            },
            "url": "{{mainBaseUrl}}/payments"
          },
          "response": []
        },
        {
          "name": "보낸 선물 목록 조회",
          "auth": {
            "type": "bearer",
            "bearer": [
              { "key": "token", "value": "{{senderAccessToken}}", "type": "string" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().data.items;",
                  "const gift = items.find(item => String(item.giftId) === pm.environment.get('acceptGiftId'));",
                  "pm.expect(gift, '생성한 선물이 목록에 있어야 한다').to.exist;",
                  "pm.expect(gift.orderId).to.eql(pm.environment.get('acceptOrderId'));",
                  "pm.expect(gift.expiresAt).to.be.a('string').and.not.empty;"
                ]
              }
