            "header": [],
            "url": "{{mainBaseUrl}}/payments/{{acceptOrderId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "03. 오류 응답",
      "description": "각 요청은 독립적으로 실행할 수 있다. 결제 거절 요청은 로컬 Payment Server의 DECLINE 시나리오를 사용한다.",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{senderAccessToken}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "필수 결제 필드 누락",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.expect(body.error.code).to.eql('INVALID_REQUEST');",
                  "pm.expect(body.error.traceId).to.be.a('string').and.not.empty;"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "INVALID-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": null,\n  \"recipientUserId\": null,\n  \"quantity\": 0,\n  \"expectedUnitPrice\": -1\n}"
            },
            "url": "{{mainBaseUrl}}/payments"
          },
          "response": []
        },
        {
          "name": "결제 승인 거절",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
                  "const body = pm.response.json();",
                  "pm.expect(body.error.code).to.eql('PAYMENT_DECLINED');",
                  "pm.expect(body.error.traceId).to.be.a('string').and.not.empty;"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "DECLINE-{{$guid}}" },
              { "key": "X-Payment-Scenario", "value": "DECLINE" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"recipientUserId\": {{recipientUserId}},\n  \"quantity\": {{quantity}},\n  \"expectedUnitPrice\": {{expectedUnitPrice}}\n}"
            },
            "url": "{{mainBaseUrl}}/payments"
          },
          "response": []
        },
        {
          "name": "잘못된 주문번호 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.expect(body.error.code).to.eql('INVALID_REQUEST');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mainBaseUrl}}/payments/not-a-uuid"
          },
          "response": []
        }
      ]
    },
    {
      "name": "04. Payment Server 내부 API 진단",
      "description": "Main Backend를 거치지 않고 Payment Server 계약만 확인한다. `internalApiKey`가 비어 있으면 각 요청을 건너뛴다. 이 흐름은 Payment Server의 payments 데이터만 생성하므로 사용자 결제·선물 흐름 검증에는 사용하지 않는다.",
      "item": [
        {
          "name": "내부 결제 승인",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('internalApiKey')) pm.execution.skipRequest();",
                  "pm.environment.set('internalOrderId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.orderId).to.eql(pm.environment.get('internalOrderId'));",
                  "pm.expect(data.status).to.eql('COMPLETED');",
                  "pm.environment.set('internalPaymentKey', data.paymentKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Internal-Api-Key", "value": "{{internalApiKey}}" },
              { "key": "X-Payment-Scenario", "value": "APPROVE" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{internalOrderId}}\",\n  \"amount\": {{internalAmount}}\n}"
            },
            "url": "{{paymentBaseUrl}}/payments/confirm"
          },
          "response": []
        },
        {
          "name": "내부 결제 상태 조회",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('internalApiKey')) pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.orderId).to.eql(pm.environment.get('internalOrderId'));",
                  "pm.expect(data.status).to.eql('COMPLETED');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Internal-Api-Key", "value": "{{internalApiKey}}" }
            ],
            "url": "{{paymentBaseUrl}}/payments/orders/{{internalOrderId}}"
          },
          "response": []
        },
        {
          "name": "내부 결제 취소",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('internalApiKey')) pm.execution.skipRequest();",
                  "pm.environment.set('internalCancellationIdempotencyKey', pm.variables.replaceIn('INTERNAL-CANCEL-{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.orderId).to.eql(pm.environment.get('internalOrderId'));",
                  "pm.expect(data.status).to.eql('CANCELED');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Internal-Api-Key", "value": "{{internalApiKey}}" },
              { "key": "Idempotency-Key", "value": "{{internalCancellationIdempotencyKey}}" }
            ],
            "url": "{{paymentBaseUrl}}/payments/{{internalPaymentKey}}/cancel"
          },
          "response": []
        }
      ]
    }
  ]
}
