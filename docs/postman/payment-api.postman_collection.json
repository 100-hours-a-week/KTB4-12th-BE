{
  "info": {
    "name": "Payment API",
    "description": "결제 API 명세와 현재 구현을 기준으로 한 로컬 통합 테스트 컬렉션이다. `Payment Local` Environment를 선택하고 발신자·수신자 계정, 상품 ID, 내부 API 키를 설정한다. 두 사용자는 친구 관계여야 하며 발신자는 결제할 크레딧을 보유해야 한다. 폴더 순서대로 실행하면 로그인, 취소 흐름, 수락 흐름, 오류 응답을 검증한다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. 인증 준비",
      "description": "발신자와 수신자 계정으로 로그인하고 토큰을 Environment에 저장한다. 수신자 로그인 응답의 사용자 ID는 `recipientUserId`로 자동 저장한다.",
      "item": [
        {
          "name": "발신자 로그인",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.accessToken).to.be.a('string').and.not.empty;",
                  "pm.environment.set('senderAccessToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{senderEmail}}\",\n  \"password\": \"{{senderPassword}}\"\n}"
            },
            "url": "{{mainBaseUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "수신자 로그인",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.data.accessToken).to.be.a('string').and.not.empty;",
                  "pm.expect(body.data.user.userId).to.be.a('number');",
                  "pm.environment.set('recipientAccessToken', body.data.accessToken);",
                  "pm.environment.set('recipientUserId', String(body.data.user.userId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{recipientEmail}}\",\n  \"password\": \"{{recipientPassword}}\"\n}"
            },
            "url": "{{mainBaseUrl}}/auth/login"
          },
          "response": []
        }
      ]
    },
    {
      "name": "01. 결제 후 취소",
      "description": "사전 검증부터 승인, 동일 요청 재전송, 상태 조회, 취소와 중복 취소까지 순서대로 검증한다.",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{senderAccessToken}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "결제 전 크레딧 잔액 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const balance = pm.response.json().data.balance;",
                  "pm.expect(balance).to.be.a('number');",
                  "pm.environment.set('balanceBeforePayment', String(balance));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mainBaseUrl}}/credits/balance"
          },
          "response": []
        },
        {
          "name": "선물 사전 검증",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.product.productId).to.eql(Number(pm.environment.get('productId')));",
                  "pm.expect(data.product.quantity).to.eql(Number(pm.environment.get('quantity')));",
                  "pm.environment.set('expectedUnitPrice', String(data.product.unitPrice));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"recipientUserId\": {{recipientUserId}},\n  \"quantity\": {{quantity}}\n}"
            },
            "url": "{{mainBaseUrl}}/gifts/preflight"
          },
          "response": []
        },
        {
          "name": "결제 승인",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('paymentIdempotencyKey', pm.variables.replaceIn('PAYMENT-{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.paymentStatus).to.eql('COMPLETED');",
                  "pm.expect(data.giftStatus).to.eql('WAITING_FOR_ACCEPTANCE');",
                  "pm.expect(data.giftExpiresAt).to.be.a('string').and.not.empty;",
                  "pm.environment.set('orderId', data.orderId);",
                  "pm.environment.set('giftId', String(data.giftId));",
                  "pm.environment.set('paymentKey', data.paymentKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{paymentIdempotencyKey}}" },
              { "key": "X-Payment-Scenario", "value": "{{paymentScenario}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"recipientUserId\": {{recipientUserId}},\n  \"quantity\": {{quantity}},\n  \"expectedUnitPrice\": {{expectedUnitPrice}}\n}"
            },
            "url": "{{mainBaseUrl}}/payments"
          },
          "response": []
        },
        {
          "name": "동일 결제 요청 재전송",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.orderId).to.eql(pm.environment.get('orderId'));",
                  "pm.expect(String(data.giftId)).to.eql(pm.environment.get('giftId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{paymentIdempotencyKey}}" },
              { "key": "X-Payment-Scenario", "value": "{{paymentScenario}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"recipientUserId\": {{recipientUserId}},\n  \"quantity\": {{quantity}},\n  \"expectedUnitPrice\": {{expectedUnitPrice}}\n}"
            },
            "url": "{{mainBaseUrl}}/payments"
          },
          "response": []
        },
        {
          "name": "결제 상태 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.orderId).to.eql(pm.environment.get('orderId'));",
                  "pm.expect(data.paymentStatus).to.eql('COMPLETED');",
                  "pm.expect(data.giftStatus).to.eql('WAITING_FOR_ACCEPTANCE');"
