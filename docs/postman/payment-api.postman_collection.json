                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Idempotency-Key", "value": "{{cancellationIdempotencyKey}}" }
            ],
            "url": "{{mainBaseUrl}}/payments/{{orderId}}/cancellations"
          },
          "response": []
        },
        {
          "name": "취소 상태 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.paymentStatus).to.eql('CANCELED');",
                  "pm.expect(data.giftStatus).to.eql('CANCELED');",
