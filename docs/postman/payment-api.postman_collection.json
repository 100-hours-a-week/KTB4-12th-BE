          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mainBaseUrl}}/payments/{{orderId}}"
          },
          "response": []
        },
        {
          "name": "보낸 선물 상세 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
