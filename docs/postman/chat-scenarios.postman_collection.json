{
  "info": {
    "name": "AI Chat PR2 시나리오 검증",
    "description": "BE를 AI /v1/chat/test/conversations에 연결한 뒤 AI Chat Local 환경으로 전체 컬렉션을 Runner에서 실행. Iterations=1, Delay=500ms 권장. 60초는 테스트 조회 중단 기준이며 제품 timeout 정책이 아님. 가이드의 9개 시나리오를 JSON API 범위로 검사. SSE delta 경계 및 reconnect 자체는 PR 3 범위. 가상 상품으로 실제 구매하지 않음.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "for (const key of ['baseUrl', 'accessToken', 'recipientUserId']) {",
          "  if (!pm.environment.get(key)) throw new Error('AI Chat Local 환경의 ' + key + ' 값을 입력하세요.');",
          "}",
          "if (!Number.isSafeInteger(Number(pm.environment.get('recipientUserId'))) || Number(pm.environment.get('recipientUserId')) < 1) {",
          "  throw new Error('recipientUserId는 활성 회원의 양의 정수 ID여야 합니다.');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "scenarioConversationId",
      "value": ""
    },
    {
      "key": "scenarioConversationToken",
      "value": ""
    },
    {
      "key": "scenarioTurnId",
      "value": ""
    },
    {
      "key": "scenarioStartedAt",
      "value": ""
    },
    {
      "key": "scenarioLastEventId",
      "value": ""
    },
    {
      "key": "scenarioPartialText",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 테스트용 대화 생성",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/recommendations/conversations/{{scenarioConversationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"recipientUserId\":{{recipientUserId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('scenarioConversationId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('대화 생성·복구 성공', () => pm.expect([200, 201].includes(pm.response.code)).to.be.true);",
              "if (![200, 201].includes(pm.response.code)) {",
              "  pm.execution.setNextRequest(null);",
              "} else {",
              "  const data = pm.response.json().data;",
              "  pm.test('대화 토큰 발급', () => pm.expect(typeof data.conversationToken === 'string' && data.conversationToken.length > 0).to.be.true);",
              "  pm.collectionVariables.set('scenarioConversationToken', data.conversationToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 cards",
      "description": "/mock cards 시나리오 검증",
      "item": [
        {
          "name": "01 cards - 질문 접수",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Conversation-Token",
                "value": "{{scenarioConversationToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/recommendations/conversations/{{scenarioConversationId}}/turns/{{scenarioTurnId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"message\": \"/mock cards\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('scenarioTurnId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('scenarioStartedAt', Date.now().toString());",
                  "pm.collectionVariables.set('scenarioLastEventId', '0');",
                  "pm.collectionVariables.set('scenarioPartialText', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('새 질문 접수', () => pm.expect(pm.response.code).to.equal(202));",
                  "if (pm.response.code !== 202) pm.execution.setNextRequest(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "01 cards - 최종 결과 조회",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Conversation-Token",
                "value": "{{scenarioConversationToken}}"
              }
            ],
            "url": "{{baseUrl}}/recommendations/conversations/{{scenarioConversationId}}/turns/{{scenarioTurnId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('조회 성공', () => pm.expect(pm.response.code).to.equal(200));",
                  "if (pm.response.code !== 200) {",
                  "  pm.execution.setNextRequest(null);",
                  "} else {",
                  "  const data = pm.response.json().data;",
                  "  const text = data.blocks.filter(b => b.type === 'text').map(b => b.text).join('\\n');",
                  "  const cards = data.blocks.filter(b => b.type === 'cards');",
                  "  pm.test('동일 턴 조회', () => pm.expect(data.turnId).to.equal(pm.collectionVariables.get('scenarioTurnId')));",
                  "  const previous = Number(pm.collectionVariables.get('scenarioLastEventId') || 0);",
                  "  pm.test('이벤트 번호는 감소하지 않음', () => pm.expect(data.lastEventId).to.be.at.least(previous));",
                  "  pm.collectionVariables.set('scenarioLastEventId', String(data.lastEventId));",
                  "  const elapsed = Date.now() - Number(pm.collectionVariables.get('scenarioStartedAt'));",
                  "  if (data.status === 'PROCESSING' && elapsed < 60000) {",
                  "    pm.execution.setNextRequest(pm.info.requestId);",
                  "  } else {",
                  "    pm.test('최종 상태 COMPLETED', () => pm.expect(data.status).to.equal('COMPLETED'));",
                  "    pm.test('가상 카드 3개', () => pm.expect(cards.length === 1 && cards[0].products.length === 3).to.be.true);",
                  "    pm.test('텍스트와 카드 함께 제공', () => pm.expect(text.length > 0).to.be.true);    if (data.status === 'PROCESSING') pm.execution.setNextRequest(null);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
